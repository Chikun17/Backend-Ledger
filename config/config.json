{
  "development": {
    "url": "postgres://<DB_USER>:<DB_PASSWORD>@localhost:5432/<DB_NAME>",
    "dialect": "postgres"
  },
  "test": {
    "url": "postgres://<DB_USER>:<DB_PASSWORD>@localhost:5432/<DB_NAME>_test",
    "dialect": "postgres"
  },
  "production": {
    "url": "postgres://<DB_USER>:<DB_PASSWORD>@<HOST>:5432/<DB_NAME>",
    "dialect": "postgres"
  }
}
